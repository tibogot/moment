# The address the site believes it lives at. This is the switch that opens the
# site to Google: any localhost or *.vercel.app value serves `Disallow: /` plus
# noindex on every page, deliberately, so the temporary address never gets
# indexed. Set it to https://www.moment-lab.be the day the domain is connected.
NEXT_PUBLIC_SITE_URL=

# Shopify Storefront API
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2026-01

# Shopify Admin API — counts orders per delivery window so a full one closes.
# Scopes: read_orders, write_orders, read_all_orders. Either a custom app's
# fixed token, or a Dev Dashboard app's client id + secret (same organisation
# as the shop). Unset: capacity is off and every window is offered.
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_ADMIN_CLIENT_ID=
SHOPIFY_ADMIN_CLIENT_SECRET=

# Google Analytics 4. Set on the PRODUCTION deployment only (G-43F991WPBG):
# unset, there is no tag and the cookie banner does not ask about analytics,
# so local and preview traffic never reaches the owners' reports.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Shopify Customer Account API (optional)
SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_ID=
SHOPIFY_APP_URL=
NEXT_PUBLIC_APP_URL=

# Belgium-wide address lookup (Geoapify). Free tier is 3,000 requests/day,
# which the day-long fetch cache in front of it makes ample. Without this the
# lookup falls back to UrbIS and can only find addresses inside Brussels.
GEOAPIFY_API_KEY=
# A SECOND Geoapify key, for the map tiles on /find-us. It is visible in every
# tile URL, so restrict it to the site's domain in the Geoapify dashboard
# (API keys → allowed origins). Unset in production: the page shows the list
# of partners without a map. Local and preview fall back to OSM tiles.
GEOAPIFY_MAP_KEY=

# Sanity CMS (moment-sanity)
NEXT_PUBLIC_SANITY_PROJECT_ID=msn9ulmx
NEXT_PUBLIC_SANITY_DATASET=production

# On-demand revalidation. Pages are cached until one of these webhooks says
# otherwise, with only a 24h backstop behind them (lib/cache.ts), so an unset
# secret means the site runs up to a day behind on content. Both endpoints
# reject unsigned requests and log loudly. Setup steps are in the route files:
# app/api/revalidate/sanity/route.ts and app/api/revalidate/shopify/route.ts.
# Generate with: openssl rand -base64 32
SANITY_REVALIDATE_SECRET=
# Shown once by Shopify when you create the first webhook; one per shop.
SHOPIFY_WEBHOOK_SECRET=

# Contact form delivery (Resend). Until all three are set the form validates
# and then reports a send failure, logging the enquiry to the server console.
RESEND_API_KEY=
# Must be on a domain verified in Resend, e.g. info@moment-lab.be
CONTACT_EMAIL_FROM=
# Where quote requests land.
CONTACT_EMAIL_TO=
