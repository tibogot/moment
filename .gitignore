# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# The template is the exception: it holds no values, and without it a fresh
# clone has no way of knowing which variables the app reads.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Sanity TypeGen. `sanity.types.ts` is committed so a fresh clone type-checks
# without running the CLI; `schema.json` is the intermediate the CLI writes on
# the way there — 50KB of regenerable JSON that would churn on every schema
# edit. `npm run typegen` rebuilds both.
schema.json
